# Copy to Infra/.env and fill in. Infra/.env is gitignored -- this repository
# is PUBLIC, so a real key must never be committed here.

# --- Jev / TypeSafe System One (required to score) ---
TYPESAFE_API_KEY=your-jev-api-key-here
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_TIMEOUT_SECONDS=15
# JEV_MAX_ATTEMPTS=3

# --- BrainOpsHub CRM (required to persist; scoring works without it) ---
# No service role key. This service signs a short-lived token for the
# autogtm_writer role, which can execute two functions and read no table.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-project-jwt-secret-here
# CRM_ROLE=autogtm_writer
# CRM_TOKEN_TTL_SECONDS=300

# --- Qualification ---
# Default threshold; a campaign may override it with its own min_fit_score.
# MIN_FIT_SCORE=70
