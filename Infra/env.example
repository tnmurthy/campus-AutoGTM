# Copy to Infra/.env and fill in. Infra/.env is gitignored -- this repository
# is PUBLIC, so a real key must never be committed here.

# --- Jev / TypeSafe System One (required to score) ---
TYPESAFE_API_KEY=your-jev-api-key-here
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_TIMEOUT_SECONDS=15
# JEV_MAX_ATTEMPTS=3

# --- BrainOpsHub Supabase (required to persist; scoring works without it) ---
# SERVICE ROLE key: bypasses row level security. Server-side only, never in a
# browser bundle and never in a log line.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Qualification ---
# Default threshold; a campaign may override it with its own min_fit_score.
# MIN_FIT_SCORE=70
